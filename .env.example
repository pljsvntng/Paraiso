# Server only. Use a PostgreSQL connection with certificate verification (Neon: sslmode=verify-full).
DATABASE_URL=
# Development: use a dedicated paraiso_dev database in .env.local.
# Staging: use a different database/role and host-managed secrets, separate from production.
# Local URL shape: postgresql://USER:URL_ENCODED_PASSWORD@127.0.0.1:5432/paraiso_dev?sslmode=disable
# Remote providers: use their certificate-verifying TLS URL (normally sslmode=verify-full).
# Exact public origin, no path; required in production for CSRF and Microsoft redirects.
APP_URL=http://127.0.0.1:3000
# Only set when your hosting proxy overwrites this header and cannot be bypassed.
# Otherwise rate limits deliberately use a shared bucket for the application.
TRUSTED_IP_HEADER=
# Random 32+ byte worker secret; scheduled server POST /api/reservations/worker/
JOBS_SECRET=
# SMTP: use port 587 with STARTTLS or 465 with SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
STAFF_NOTIFICATION_EMAILS=
# Microsoft Entra single-tenant web application. Delegated Files.ReadWrite + offline_access.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Generate with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable, secret and backed up: encrypts Microsoft refresh tokens in PostgreSQL.
INTEGRATION_ENCRYPTION_KEY=
# Payment processing is retired. Existing private historical credentials may stay in server storage.
# Public reference tracking does not require SMTP or an integration encryption key.
# Run the private worker every minute for optional reservation notifications.
# ADMIN_EMAIL / ADMIN_NAME / ADMIN_PASSWORD are read only by admin:create.
# Supply temporarily in your terminal; do not put passwords in this file or source control.
# Read-only diagnostics: npm run db:check and npm run ops:readiness.
# BOOKING_BROWSER_TESTS=1 enables isolated Edge/Chromium checks.
