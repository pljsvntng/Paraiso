generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum Role {
  ADMINISTRATOR
  MANAGER
  CONTENT_EDITOR
}
enum Kind {
  ACCOMMODATION
  COTTAGE
  ACTIVITY
  DAY_TOUR
  PACKAGE
}
enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  NO_SHOW
}
model User {
  id String @id @default(cuid())
  name String?
  email String @unique
  emailVerified DateTime?
  image String?
  role Role @default(CONTENT_EDITOR)
  active Boolean @default(true)
  accounts Account[]
  sessions Session[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Account {
  id String @id @default(cuid())
  userId String
  type String
  provider String
  providerAccountId String
  refresh_token String?
  access_token String?
  expires_at Int?
  token_type String?
  scope String?
  id_token String?
  session_state String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}
model Session {
  id String @id @default(cuid())
  sessionToken String @unique
  userId String
  expires DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model VerificationToken {
  identifier String
  token String @unique
  expires DateTime
  @@unique([identifier, token])
}
// An offering is a category; resources are its actual physical units or capacity pools.
model Offering {
  id String @id @default(cuid())
  slug String @unique
  kind Kind
  name String
  description String
  details String @default("")
  published Boolean @default(false)
  verified Boolean @default(false)
  status String @default("Ask about availability")
  amenities String[] @default([])
  bedConfiguration String?
  inclusions String[] @default([])
  terms String?
  validFrom DateTime? @db.Date
  validUntil DateTime? @db.Date
  resources Resource[]
  images GalleryImage[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([kind, published])
}
model Resource {
  id String @id @default(cuid())
  offeringId String
  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  name String
  maxGuests Int
  inventoryCapacity Int @default(1)
  exclusive Boolean @default(true)
  active Boolean @default(false)
  rates Rate[]
  items ReservationItem[]
  blocks AvailabilityBlock[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([offeringId, name])
}
model Rate {
  id String @id @default(cuid())
  resourceId String
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  amountCentavos Int
  validFrom DateTime @db.Date
  validUntil DateTime @db.Date
  verified Boolean @default(false)
  createdAt DateTime @default(now())
  @@index([resourceId, validFrom, validUntil])
}
model Guest {
  id String @id @default(cuid())
  name String
  email String
  phone String
  reservations Reservation[]
  createdAt DateTime @default(now())
  @@index([email])
}
model Reservation {
  id String @id @default(cuid())
  reference String @unique
  idempotencyKey String @unique
  guestId String
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict)
  kind Kind
  status BookingStatus @default(PENDING)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  adults Int
  children Int
  requests String?
  totalCentavos Int?
  consentAt DateTime
  policyVersion String
  items ReservationItem[]
  payments Payment[]
  notifications Notification[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, startDate])
  @@index([guestId])
}
model ReservationItem {
  id String @id @default(cuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  resourceId String
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  quantity Int
  amountCentavos Int?
  exclusive Boolean
  active Boolean @default(true)
  @@index([resourceId, startDate, endDate, active])
}
model AvailabilityBlock {
  id String @id @default(cuid())
  resourceId String
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  reason String
  @@index([resourceId, startDate, endDate])
}
model Payment {
  id String @id @default(cuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  providerReference String? @unique
  refundReference String?
  amountCentavos Int
  status String @default("UNPAID")
  events PaymentEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentEvent {
  id String @id @default(cuid())
  providerEventId String @unique
  paymentId String
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  type String
  processedAt DateTime @default(now())
}
model GalleryImage {
  id String @id @default(cuid())
  publicId String @unique
  url String
  alt String
  category String
  approved Boolean @default(false)
  featured Boolean @default(false)
  offeringId String?
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}
model MenuCategory {
  id String @id @default(cuid())
  name String @unique
  items MenuItem[]
}
model MenuItem {
  id String @id @default(cuid())
  categoryId String
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name String
  description String
  priceCentavos Int?
  published Boolean @default(false)
  externalPosId String? @unique
  updatedAt DateTime @updatedAt
}
model Inquiry {
  id String @id @default(cuid())
  name String
  email String
  phone String?
  type String
  message String
  status String @default("NEW")
  consentAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, createdAt])
}
model WebsiteContent {
  id String @id @default(cuid())
  key String @unique
  title String
  body String
  published Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model Announcement {
  id String @id @default(cuid())
  title String
  body String
  published Boolean @default(false)
  expiresAt DateTime?
  updatedAt DateTime @updatedAt
}
model ResortSettings {
  id String @id @default("resort")
  phone String?
  email String?
  address String?
  mapEmbedUrl String?
  directionsUrl String?
  locationVerified Boolean @default(false)
  hours String?
  privacyContact String?
  retentionDays Int @default(365)
  bookingEnabled Boolean @default(false)
  policyVersion String @default("draft-1")
  policiesApproved Boolean @default(false)
  logoUrl String?
  updatedAt DateTime @updatedAt
}
model Notification {
  id String @id @default(cuid())
  reservationId String?
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  recipient String
  subject String
  body String
  sentAt DateTime?
  attempts Int @default(0)
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  actorId String
  action String
  entity String
  entityId String
  detail Json?
  createdAt DateTime @default(now())
  @@index([createdAt])
}
model RateLimit {
  key String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
}
